# Discord bot credentials — https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Set for instant command registration in a test guild (right-click server → Copy Server ID)
GUILD_ID=

# --- "Ask BB-Bot" LLM voice (optional; falls back to the canned line-bank on any failure) ---
# Route selector — which backend voices the grognard at the invoke point:
#   claude → Anthropic Claude (needs ANTHROPIC_API_KEY below)
#   codex  → OpenAI Sol 5.6 via the local Codex CLI (reuses your ChatGPT OAuth login; NO key needed)
#   off    → skip the LLM, pure canned
# Unset ⇒ claude if ANTHROPIC_API_KEY is present, else codex.
GROGNARD_BACKEND=

# claude path
ANTHROPIC_API_KEY=
GROGNARD_CLAUDE_MODEL=   # default claude-haiku-4-5

# codex path (no key — uses `codex login` OAuth in ~/.codex). codex CLI must be installed + logged in.
GROGNARD_CODEX_MODEL=    # default gpt-5.6-sol
CODEX_BIN=               # full path to the codex binary if it isn't on the bot's PATH (e.g. %APPDATA%\npm\codex.cmd)
GROGNARD_CODEX_CWD=      # working root codex runs in (read-only sandbox); default: the discord-bot app dir

# Where validated-rosters.csv + coaches.json live (default ./data-store)
DATA_DIR=
# Where tournament package JSONs live (default ../../tournament-packages)
PACKAGES_DIR=

# --- FUMBBL40k fork provisioning (/bbbot 40k) ---
# Only works when the bot runs ON the fork host. Leave FORK_TEAMS_DIR unset to disable.
FORK_TEAMS_DIR=
FORK_DB_HOST=127.0.0.1
FORK_DB_PORT=3316
FORK_DB_USER=ffb
FORK_DB_PASSWORD=ffb
FORK_DB_NAME=ffblive
# Build announcer: path to the FUMBBL40k client's latest-build.json (defaults to the
# sibling repo under the shared Claude dir).
FORK_BUILD_MANIFEST=
# Daily-summary announcer: path to the shared cross-track end-of-day file (defaults to
# the sibling fumbbl40k-client repo's docs/daily-summary.md).
FORK_DAILY_SUMMARY=
# Role pinged at the head of EVERY BUILD announcement (the "FUMBBL40k Tester" role). Set this
# only to override the id for a different guild — leaving it empty/unset uses the default
# (it does NOT disable the ping; a build announce always pings). Daily summaries don't ping.
FORK_TESTER_ROLE_ID=
