# Config pane server — all of these are optional; sane defaults apply.
PORT=4310
HOST=127.0.0.1
# Set to require Basic auth for everything except /api/fork/* (see PUBLIC_PATHS in server.ts).
ADMIN_PASSWORD=
PACKAGES_DIR=
VALIDATED_CSV=

# FUMBBL40k fork DB (only needed for /api/fork/register — "Register this coach on
# the fork" from the client's Connection pane). Leave FORK_DB_HOST unset to disable;
# matches the Discord bot's own FORK_DB_* values (same fork, same DB).
FORK_DB_HOST=
FORK_DB_PORT=3316
FORK_DB_USER=ffb
FORK_DB_PASSWORD=ffb
FORK_DB_NAME=ffblive
