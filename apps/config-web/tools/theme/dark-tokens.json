{
  "_doc": "Dark-theme token values (the source of the light palette). derive-light.mjs maps each to its light value by role and writes it into the light token blocks named in 'blocks'. Entries are processed in order: an 'on' list may only name tokens derived above it. Edit a dark value here when its dark block changes, then run: node tools/theme/derive-light.mjs --write",
  "blocks": {
    "theme": { "file": "public/theme.css", "selector": ":root[data-theme=\"light\"] {" },
    "home": { "file": "spa/src/home/home.css", "selector": ":root[data-theme=\"light\"] {" },
    "builder": { "file": "spa/src/teams/builder.css", "selector": ":root[data-theme=\"light\"] .tb-page {" },
    "teams": { "file": "spa/src/teams/teams.css", "selector": ":root[data-theme=\"light\"] .tm-page {" },
    "rosters": { "file": "spa/src/tabletop/tabletop.css", "selector": ":root[data-theme=\"light\"] .tt-rosters {" },
    "rec": { "file": "spa/src/tabletop/tabletop.css", "selector": ":root[data-theme=\"light\"] .tt-rec { --seat" },
    "pcard": { "file": "spa/src/tabletop/tabletop.css", "selector": ":root[data-theme=\"light\"] .tt-pcard {" },
    "legacyBuilder": { "file": "public/team-builder.css", "selector": ":root[data-theme=\"light\"] {" },
    "legacyRules": { "file": "public/tournament-rules.css", "selector": ":root[data-theme=\"light\"] {\n" },
    "legacyRulesShadow": { "file": "public/tournament-rules.css", "selector": ":root[data-theme=\"light\"] { color-scheme: light;" }
  },
  "groups": {
    "@surfaces": ["--ui-secondary", "--ui-surface", "--ui-surface-2", "--sf-panel-top", "--sf-panel-bottom"],
    "@chip": ["--ui-secondary", "--ui-surface", "--ui-surface-2", "--sf-panel-top", "--sf-panel-bottom", "--tb-skillbar"]
  },
  "tokens": [
    { "name": "--ui-secondary", "dark": "#000000", "role": "surface", "blocks": ["theme"] },
    { "name": "--ui-surface", "dark": "#0d0d0d", "role": "surface", "blocks": ["theme"] },
    { "name": "--ui-surface-2", "dark": "#242424", "role": "surface", "blocks": ["theme"] },
    { "name": "--ui-hover", "dark": "#250a0b", "role": "surface", "dl": 0.015, "blocks": ["theme"] },
    { "name": "--ui-border", "dark": "#3d0002", "role": "line", "blocks": ["theme"] },
    { "name": "--sf-panel-top", "dark": "rgb(35 39 45 / 0.9)", "role": "surface", "pairTop": "--sf-panel-bottom", "over": "--ui-surface", "blocks": ["home"] },
    { "name": "--sf-panel-bottom", "dark": "rgb(10 12 15 / 0.9)", "role": "surface", "over": "--ui-surface", "blocks": ["home"] },
    { "name": "--sf-panel-line", "dark": "#353b44", "role": "line", "blocks": ["home"] },
    { "name": "--sf-panel-drop", "dark": "#050607", "role": "drop", "blocks": ["home"] },
    { "name": "--sf-panel-hi", "dark": "#626b77", "role": "highlight", "blocks": ["home"] },
    { "name": "--sf-bevel", "dark": "inset 0 1px 0 rgb(255 255 255 / 0.16), inset 0 -1px 0 rgb(0 0 0 / 0.4)", "role": "bevel", "blocks": ["home"] },
    { "name": "--tb-skillbar", "dark": { "mix": ["#242424", 0.8, "#ffffff"] }, "role": "surface", "blocks": ["builder"] },
    { "name": "--ui-primary", "dark": "#790004", "role": "accent", "on": ["#ffffff"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-active", "dark": "#790004", "role": "accent", "on": ["#ffffff"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--th-band", "role": "calc", "light": { "mix": ["--ui-primary", 0.26, "--ui-surface-2"] }, "blocks": [] },
    { "name": "--ui-text-on-accent", "dark": "#ffffff", "role": "fixed", "blocks": ["theme"] },
    { "name": "--ui-text-on-primary", "dark": "#ffffff", "role": "fixed", "blocks": ["theme"] },
    { "name": "--ui-focus-halo", "dark": "#ffffff", "role": "fixed", "blocks": ["theme"] },
    { "name": "--ui-text-on-secondary", "dark": "#ffffff", "role": "ink", "on": ["--ui-secondary"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-text", "dark": "#e6e9ef", "role": "ink", "on": ["@chip", "--ui-hover"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-muted", "dark": "#848689", "role": "ink", "on": ["@chip", "--ui-hover"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-text-dim", "dark": "#5f6163", "role": "ink", "on": ["@surfaces"], "min": 3, "blocks": ["theme"] },
    { "name": "--ui-accent", "dark": "#a55456", "role": "accent", "on": ["#ffffff", "@surfaces"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-heading", "dark": "#ff3b3b", "role": "accent", "on": ["@surfaces", "--ui-hover"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-focus", "dark": "#ff3b3b", "role": "accent", "on": ["@surfaces"], "min": 3, "blocks": ["theme"] },
    { "name": "--ui-coach-led", "dark": "#4cff6a", "role": "accent", "on": ["@surfaces"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-danger", "dark": "#ff4d4d", "role": "accent", "on": ["@surfaces"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--ui-success", "dark": "#3fb463", "role": "accent", "on": ["@surfaces"], "min": 4.5, "blocks": ["theme"] },
    { "name": "--success-ink", "dark": "#3fb463", "role": "accent", "on": ["@surfaces"], "min": 4.5, "blocks": ["legacyRulesShadow"] },
    { "name": "--shadow", "dark": "rgb(0 0 0 / 45%)", "role": "shade", "blocks": ["legacyRulesShadow"] },
    { "name": "--sf-seat-home", "dark": "#4a86fe", "role": "accent", "on": ["@surfaces", "--ui-hover"], "min": 4.5, "blocks": ["home"] },
    { "name": "--sf-seat-away", "dark": "#fe6666", "role": "accent", "on": ["@surfaces", "--ui-hover"], "min": 4.5, "blocks": ["home"] },
    { "name": "--sf-gold", "dark": "#e8a33d", "role": "accent", "on": ["@surfaces", "--ui-hover"], "min": 4.5, "blocks": ["home"] },
    { "name": "--tb-skillbar-muted", "dark": "#d0d3d8", "role": "ink", "on": ["--tb-skillbar"], "min": 4.5, "blocks": ["builder"] },
    { "name": "--tb-secondary-bar", "dark": "#ffffff", "role": "ink", "on": ["--ui-surface-2", "--tb-skillbar"], "min": 4.5, "blocks": ["builder"] },
    { "name": "--tb-badge-ink", "dark": "#ffffff", "role": "fixed", "blocks": ["builder"] },
    { "name": "--tb-badge-line", "dark": "rgb(0 0 0 / 75%)", "role": "shade", "blocks": ["builder"] },
    { "name": "--tb-badge-drop", "dark": "rgb(0 0 0 / 50%)", "role": "shade", "blocks": ["builder"] },
    { "name": "--tb-num-outline", "dark": "-1px -1px 0 #000000, 1px -1px 0 #000000, -1px 1px 0 #000000, 1px 1px 0 #000000, 0 0 4px rgb(0 0 0 / 80%)", "role": "fixed", "blocks": ["builder"] },
    { "name": "--ui-gold", "dark": "#e8a33d", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-position", "dark": "#ffd23d", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "legacyBuilder"] },
    { "name": "--ui-role", "dark": "#c9c9c9", "role": "ink", "on": ["@chip"], "min": 4.5, "blocks": ["legacyBuilder"] },
    { "name": "--ui-eggshell", "dark": "#e7ddc7", "role": "ink", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-general", "dark": "#6ea8ff", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-agility", "dark": "#ffd23d", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-strength", "dark": "#ff6b6b", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-passing", "dark": "#ffffff", "role": "ink", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-mutation", "dark": "#6fcf6f", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-skill-trait", "dark": "#b08b5a", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["teams", "rosters", "pcard", "legacyBuilder", "legacyRules"] },
    { "name": "--ui-table-head-ink", "dark": "#ff6b6b", "role": "accent", "on": ["--th-band", "@chip"], "min": 4.5, "blocks": ["teams", "rosters", "legacyBuilder"] },
    { "name": "--tt-home", "dark": "#4a86c8", "role": "tint", "blocks": ["rec"] },
    { "name": "--tt-away", "dark": "#ff4d4d", "role": "tint", "blocks": ["rec"] },
    { "name": "--seat-home-text", "dark": "#4a86fe", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["rosters", "rec", "pcard"] },
    { "name": "--seat-away-text", "dark": "#fe6666", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["rosters", "rec", "pcard"] },
    { "name": "--tt-st-ko", "dark": "#e0b040", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["rosters", "pcard"] },
    { "name": "--tt-st-bad", "dark": "#e07a7a", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["rosters", "pcard"] },
    { "name": "--tt-st-down", "dark": "#f05050", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["rosters", "pcard"] },
    { "name": "--tt-st-up", "dark": "#4fce6a", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["pcard"] },
    { "name": "--tt-st-res", "dark": "#8a9ac0", "role": "accent", "on": ["@chip"], "min": 4.5, "blocks": ["pcard"] }
  ]
}
