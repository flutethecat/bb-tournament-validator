{
  "name": "config-web",
  "version": "0.1.0",
  "private": true,
  "description": "TO configuration pane: author tournament packages + coaches dashboard (served over HTTP).",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "build:lobby": "vite build --config lobby/vite.config.ts",
    "build:spa": "vite build --config spa/vite.config.ts",
    "typecheck:spa": "vue-tsc -p spa/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bb/fork-ops": "workspace:*",
    "@bb/validator": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
